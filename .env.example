# Model service
OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=replace-me

# Local infrastructure created by compose.yaml
MYSQL_ROOT_PASSWORD=change-me
MYSQL_USERNAME=root
MYSQL_PASSWORD=change-me
MYSQL_URL=jdbc:mysql://127.0.0.1:13306/ai-agent-station-study?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
PGVECTOR_USERNAME=postgres
PGVECTOR_PASSWORD=change-me
PGVECTOR_URL=jdbc:postgresql://127.0.0.1:15432/ai-rag-knowledge

# Java service supervision
OPS_SUPERVISION_ENABLED=true
OPS_SELF_BASE_URL=http://127.0.0.1:8099
OPS_DEFAULT_AGENT_ID=3
OPS_SCHEDULER_DELAY_MS=10000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend build; leave empty for same-origin production deployment
PUBLIC_API_BASE_URL=http://127.0.0.1:8099
